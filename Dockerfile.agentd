FROM rust:alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /build

COPY . .

RUN set -eux; \
    version="$(sed -n '/^\[workspace.package\]/,/^\[/ s/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1 | tr -d '\r')"; \
    rm -f Cargo.lock; \
    cat > Cargo.toml <<EOF
[workspace]
resolver = "3"
members = [
    "crates/agentd",
    "crates/protocol",
    "crates/utils",
    "packages/microsandbox-types/macros",
    "packages/microsandbox-types/rust",
]

[workspace.package]
authors = ["Super Rad Company <development@superrad.company>"]
repository = "https://github.com/superradcompany/microsandbox"
version = "$version"
license = "Apache-2.0"
edition = "2024"

[workspace.dependencies]
# microsandbox-types lists microsandbox-utils only as a dev-dependency, but Cargo still
# resolves it through this workspace, so the crate and the entries it inherits from the
# real workspace root have to appear here even though agentd never builds them.
base64 = "0.22"
bytes = "1.9"
chrono = { version = "0.4", features = ["serde"] }
ciborium = "0.2"
dirs = "7.0"
hex = "0.4"
ipnetwork = { version = "0.21.0", features = ["serde"] }
libc = "0.2"
microsandbox-protocol = { path = "crates/protocol" }
microsandbox-types = { path = "packages/microsandbox-types/rust" }
microsandbox-types-macros = { path = "packages/microsandbox-types/macros" }
microsandbox-utils = { path = "crates/utils" }
nix = "0.31"
reflink-copy = "0.1"
serde = { version = "1.0", features = ["derive"] }
serde_bytes = "0.11"
serde_json = "1.0"
sha2 = "0.11.0"
strum = { version = "0.28", features = ["derive"] }
tempfile = "3.15"
thiserror = "2.0"
tokio = { version = "1.52", features = ["full"] }
ts-rs = "12.0.1"
typed-path = "0.12"
ureq = { version = "3", features = ["platform-verifier"] }
zeroize = { version = "1.8", features = ["derive", "serde"] }
EOF

RUN cargo build --release --manifest-path crates/agentd/Cargo.toml

FROM scratch
COPY --from=builder /build/target/release/agentd /agentd
