{
  "_comment": "Checked-in accept/reject vectors for the durable header-credential grammar. Consumed by microsandbox-types domain tests; embedding applications can consume the same file so the two grammars cannot drift.",
  "accept": [
    {
      "id": "anthropic",
      "reference": "anthropic-api-key",
      "origin": { "host": "api.anthropic.com", "port": 443 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "id": "github",
      "reference": "github-token",
      "origin": { "host": "api.github.com", "port": 8443 },
      "header": "authorization",
      "format": "Bearer %s"
    },
    {
      "id": "literal-percent",
      "reference": "ref",
      "origin": { "host": "api.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "Token %s; v=100%"
    },
    {
      "id": "digits-and-hyphens",
      "reference": "ref",
      "origin": { "host": "a1-b2.example.co.uk", "port": 1 },
      "header": "x-custom-1",
      "format": "%s"
    }
  ],
  "reject": [
    {
      "_why": "empty id",
      "id": "",
      "reference": "ref",
      "origin": { "host": "api.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "_why": "empty reference",
      "id": "x",
      "reference": "",
      "origin": { "host": "api.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "_why": "wildcard host",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "*.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "_why": "IP literal host",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "127.0.0.1", "port": 443 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "_why": "uppercase host",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "API.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "_why": "trailing dot host",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "api.example.com.", "port": 443 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "_why": "scheme in host",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "https://api.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "_why": "port zero",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "api.example.com", "port": 0 },
      "header": "x-api-key",
      "format": "%s"
    },
    {
      "_why": "uppercase header",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "api.example.com", "port": 443 },
      "header": "X-Api-Key",
      "format": "%s"
    },
    {
      "_why": "forbidden hop-by-hop header",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "api.example.com", "port": 443 },
      "header": "connection",
      "format": "%s"
    },
    {
      "_why": "format without placeholder",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "api.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "Token"
    },
    {
      "_why": "format with two placeholders",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "api.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "%s %s"
    },
    {
      "_why": "format with CR",
      "id": "x",
      "reference": "ref",
      "origin": { "host": "api.example.com", "port": 443 },
      "header": "x-api-key",
      "format": "%s\r"
    }
  ],
  "serde_reject": [
    "{\"id\":\"x\",\"reference\":\"ref\",\"origin\":{\"host\":\"api.example.com\",\"port\":443},\"header\":\"x-api-key\",\"format\":\"%s\",\"value\":\"leak\"}"
  ]
}
